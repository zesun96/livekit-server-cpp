@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(Protobuf CONFIG)
if(@LIVEKIT_SERVER_USE_CURL@)
  find_dependency(CURL 7.85)
endif()
if(@LIVEKIT_SERVER_USE_OPENSSL@)
  find_dependency(OpenSSL 3.0 COMPONENTS Crypto)
endif()

set(LiveKitServer_PROTOBUF_ADAPTER_AVAILABLE @LIVEKIT_SERVER_ENABLE_PROTOBUF_ADAPTER@)

include("${CMAKE_CURRENT_LIST_DIR}/LiveKitServerTargets.cmake")
check_required_components(LiveKitServer)
